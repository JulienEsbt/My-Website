{
    "name": "my-website",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node scripts/generate-seo-pages.mjs",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "audit": "npm audit",
        "audit:prod": "npm audit --omit=dev",
        "media:audit": "node scripts/media-audit.mjs src/assets/images",
        "media:check": "node scripts/media-audit.mjs public/media --strict",
        "media:prototype": "node scripts/generate-media-prototype.mjs",
        "media:generate": "node scripts/generate-public-media.mjs",
        "budget:check": "node scripts/check-build-budgets.mjs",
        "security:files": "node scripts/check-sensitive-files.mjs",
        "seo:check": "node scripts/check-seo-build.mjs",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run security:files && npm run build && npm run seo:check && npm run budget:check && npm run audit:prod"
    },
    "engines": {
        "node": "24.x"
    },
    "dependencies": {
        "@uniswap/default-token-list": "^21.3.0",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "embla-carousel-auto-scroll": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "ethers": "^6.17.0",
        "framer-motion": "^11.18.2",
        "fuse.js": "^7.5.0",
        "gsap": "^3.15.0",
        "i18next": "^25.10.10",
        "i18next-browser-languagedetector": "^8.2.1",
        "mapbox-gl": "^3.28.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-globe.gl": "^2.38.0",
        "react-i18next": "^16.6.6",
        "react-icons": "^5.7.0",
        "react-router-dom": "^7.18.2",
        "swiper": "^12.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@mdx-js/rollup": "^3.1.1",
        "@noble/hashes": "^2.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/node": "^22.20.1",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.0.5",
        "axe-core": "^4.13.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^17.9.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "sharp": "^0.35.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    }
}
