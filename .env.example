# Client-side public configuration
VITE_MAPBOX_TOKEN=
VITE_DONATION_EVM_RECEIVER=
# Optional public HTTPS origin serving the generated /media tree.
# Leave empty to use local /public/media derivatives during development.
VITE_MEDIA_BASE_URL=
# Temporary client-side RPC configuration used by the wallet inspector.
# These values are public in the browser and must be domain-restricted.
VITE_ETH_RPC_URL=
VITE_POLYGON_RPC_URL=
VITE_ARBITRUM_RPC_URL=
VITE_OPTIMISM_RPC_URL=
VITE_BNB_RPC_URL=

# Server-only RPC configuration used by Blockchain Explorer (never prefix with VITE_)
ETH_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BNB_RPC_URL=

# Server-only contact configuration (never prefix these values with VITE_)
